# En-têtes HTTP pour Netlify et Cloudflare Pages (copié dans dist/ par build.mjs).
# Sur un autre hébergeur, reprendre les mêmes en-têtes dans sa configuration.
# La CSP est aussi dans index.html ; frame-ancestors n'est pris en compte qu'en en-tête.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=()
  Cache-Control: no-cache

# Le service worker doit toujours être relu : c'est lui qui annonce une nouvelle version.
/sw.js
  Cache-Control: no-cache, no-store

/icons/*
  Cache-Control: public, max-age=604800
